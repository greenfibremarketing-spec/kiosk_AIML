# Selectable LLM Provider: 'groq' | 'anthropic' | 'mock'
LLM_PROVIDER=groq

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MODEL_NAME=claude-3-5-sonnet-20241022

# Session Configuration
SESSION_IDLE_TIMEOUT_SECONDS=120

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Server Configuration
HOST=0.0.0.0
PORT=5007
MAX_MESSAGE_CHARS=4000

# RAG & Knowledge Configuration
VECTOR_STORE_PATH=data/vector_store
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Product ingestion (credentials belong only in .env)
MONGO_URL=
MONGO_DATABASE=greenfibre
MONGO_PRODUCTS_COLLECTION=products
# For local MongoDB use mongodb://localhost:27017/greenfibre
# Leave empty to write chunks to the source Atlas database.
MONGO_CHUNKS_URL=
MONGO_CHUNKS_DATABASE=greenfibre
MONGO_CHUNKS_COLLECTION=product_chunks
