# Selectable LLM Provider: 'groq' | 'anthropic' | 'mock'
LLM_PROVIDER=groq

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MODEL_NAME=claude-3-5-sonnet-20241022

# Session Configuration
SESSION_IDLE_TIMEOUT_SECONDS=120

# CORS Configuration (comma-separated origins)
# app://kiosk must be included for Electron production builds
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,app://kiosk

# Server Configuration
HOST=0.0.0.0
PORT=5007
MAX_MESSAGE_CHARS=4000

# Website product API (public read-only endpoints; no token required as discovered)
PRODUCT_SOURCE=greenfibre
GREENFIBRE_API_BASE_URL=https://api.greenfibre.org/api
GREENFIBRE_API_TOKEN=
GREENFIBRE_API_TIMEOUT_SECONDS=8
GREENFIBRE_CATALOGUE_CACHE_SECONDS=30
GREENFIBRE_API_MAX_PAGES=20
# Offline development only: PRODUCT_SOURCE=json and LLM_PROVIDER=mock

# RAG & Knowledge Configuration
VECTOR_STORE_PATH=data/vector_store
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Product ingestion (credentials belong only in .env)
MONGO_URL=
MONGO_DATABASE=greenfibre
MONGO_PRODUCTS_COLLECTION=products
# For local MongoDB use mongodb://localhost:27017/greenfibre
# Leave empty to write chunks to the source Atlas database.
MONGO_CHUNKS_URL=
MONGO_CHUNKS_DATABASE=greenfibre
MONGO_CHUNKS_COLLECTION=product_chunks

# ────────────────────────────────────────────────────────────────────────────
# greeny_ai operational database (Stage 4 — not used in Stage 1)
# Use a dedicated database user with read/write on greeny_ai only.
# Never reuse the product catalogue credentials here.
# ────────────────────────────────────────────────────────────────────────────
GREENY_AI_MONGO_URL=
GREENY_AI_MONGO_DATABASE=greeny_ai
# Retention policy in days (0 = never purge automatically)
GREENY_AI_RETENTION_DAYS=90
# Internal admin API token (generate with: python -c "import secrets; print(secrets.token_hex(32))")
GREENY_AI_ADMIN_TOKEN=

# Backend admission limits (shared when using MongoDB)
REQUESTS_PER_MINUTE=120
WS_FRAMES_PER_MINUTE=120
MAX_WS_CONNECTIONS=16
MAX_INFLIGHT_TURNS=4
LLM_REQUEST_TIMEOUT_SECONDS=20
